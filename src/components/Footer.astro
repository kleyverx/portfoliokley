---
---
<footer class="w-full border-t border-border/50 bg-background py-6 relative z-10">
  <div class="container mx-auto flex flex-col items-center justify-center gap-4 md:flex-row md:justify-between px-4">
    <p class="text-center text-sm leading-loose text-mutedForeground md:text-left lang-text" data-key="derechos">
      © 2024 クレイバー • Kleyver Urbina. Todos los derechos reservados.
    </p>
    <div class="flex flex-wrap justify-center gap-x-4 gap-y-2 items-center max-w-full">
      <button class="text-sm font-medium hover:text-primary transition-colors">
        <span class="lang-text" data-key="terminos">Términos</span>
      </button>
      <button class="text-sm font-medium hover:text-primary transition-colors">
        <span class="lang-text" data-key="privacidad">Privacidad</span>
      </button>
      <button data-section="contacto" class="text-sm font-medium hover:text-primary transition-colors nav-link">
        <span class="lang-text" data-key="contacto">Contacto</span>
      </button>

      <!-- Selector de idioma -->
      <div class="flex items-center ml-4 border-l border-border/50 pl-4">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4 mr-2 text-mutedForeground clean-icon">
          <circle cx="12" cy="12" r="10" />
          <path d="M2 12h20" />
          <path d="M12 2a15.3 15.3 0 0 1 0 20 15.3 15.3 0 0 1 0-20" />
        </svg>
        <select id="language-selector" class="bg-background border border-primary/20 rounded-md text-sm h-8 px-2 focus:outline-none focus:ring-2 focus:ring-primary text-foreground">
          <option value="es" class="bg-background text-foreground">Español</option>
          <option value="en" class="bg-background text-foreground">English</option>
          <option value="fr" class="bg-background text-foreground">Français</option>
        </select>
      </div>
    </div>
  </div>
</footer>
