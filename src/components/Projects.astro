---
import { Image } from 'astro:assets';
import projectsData from '../data/projects.json';

// Importar todas las imágenes de la carpeta de proyectos
const images = import.meta.glob<{ default: ImageMetadata }>('../assets/images/projects/*.{jpeg,jpg,png,gif,webp}');

// Mostrar los primeros 10 proyectos (igual que hacía el JS)
const projects = projectsData.slice(0, 10);
---
<section id="proyectos" class="w-full pt-16 pb-8 md:pt-24 md:pb-12 lg:pt-32 lg:pb-16 relative pointer-events-auto" style="overflow-x: clip; overflow-y: visible;">

  <div class="container mx-auto px-4 md:px-6 relative z-10">
    <div class="flex flex-col items-center justify-center space-y-4 text-center">
      <div class="space-y-2">
        <span class="animate-element opacity-0 transition-all duration-700 inline-flex bg-primary/25 text-secondary text-sm md:text-base hover:bg-primary/35 px-3 py-1 rounded-full border border-primary/40 w-fit font-medium">
          <span class="lang-text" data-key="proyectosTitulo">プロジェクト • Proyectos</span>
        </span>
        <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight animate-element opacity-0 transition-all duration-700 delay-200 neon-text" data-translate="projects.title">
          Proyectos Destacados
        </h2>
        <p class="mx-auto max-w-[700px] text-white/70 md:text-xl/relaxed lg:text-base/relaxed xl:text-xl/relaxed animate-element opacity-0 transition-all duration-700 delay-300" data-translate="projects.subtitle">
          Una selección de mis trabajos más recientes y destacados
        </p>
      </div>
    </div>
    
    <!-- Modelo 3D Integrado -->
    <div class="mx-auto max-w-4xl animate-element opacity-0 transition-all duration-700 delay-400">
      <!-- Contenedor del modelo 3D -->
      <div class="relative w-full h-[300px] md:h-[500px] lg:h-[600px] rounded-lg overflow-hidden bg-transparent">
        <div id="spline-container" class="w-full h-full">
          <!-- Modelo 3D de Spline -->
          <iframe src="https://my.spline.design/nexbotrobotcharacterconcept-UfETkdQciGqKQFyjGephG42H/" frameborder="0" width="100%" height="100%" loading="lazy" title="Robot 3D Interactivo"></iframe>
        </div>
      </div>
    </div>

    <!-- Grid horizontal de proyectos -->
    <div id="projects-pin-container" class="relative mt-0 md:mt-6 mb-16 py-4 md:py-8 overflow-visible" style="width: 100vw; left: 50%; right: 50%; margin-left: -50vw; margin-right: -50vw;">
      <div id="projects-grid" class="projects-horizontal-track flex flex-nowrap items-stretch gap-6 px-4 md:px-[5vw] pt-4 pb-16 w-max">
        {projects.map((p) => {
          // Obtener el nombre del archivo de la ruta en el JSON
          const imgFilename = p.image.split('/').pop();
          const imagePath = `../assets/images/projects/${imgFilename}`;
          const imageLoader = images[imagePath];
          
          return (
            <div class="project-card w-[85vw] md:w-[60vw] lg:w-[450px] shrink-0 glass-panel glass-panel-hover rounded-xl shadow-lg hover:shadow-xl transition-all duration-300 flex flex-col">
              <div class="aspect-video overflow-hidden rounded-t-xl">
                {imageLoader ? (
                  <Image 
                    src={imageLoader()} 
                    alt={p.title} 
                    width={450}
                    height={253}
                    class="object-cover w-full h-full transition-transform duration-500" 
                    loading="eager"
                  />
                ) : (
                  <div class="w-full h-full bg-muted flex items-center justify-center text-xs opacity-50">
                    Image Not Found
                  </div>
                )}
              </div>
              <div class="p-6 flex flex-col grow">
                <h3 class="text-xl font-semibold mb-2 text-foreground">{p.title}</h3>
                <p class="text-muted-foreground mb-4 grow">{p.description}</p>
                <div class="flex flex-wrap gap-2 mb-4">
                  {(Array.isArray(p.technologies) ? p.technologies : []).map((t) => (
                    <span class="px-2 py-1 bg-accent/30 text-accent-foreground text-[10px] uppercase tracking-wider rounded-full border border-primary/20">
                      {t}
                    </span>
                  ))}
                </div>
                <div class="flex gap-4 pt-4 border-t border-white/10">
                  {p.codeUrl && (
                    <a href={p.codeUrl} target="_blank" class="inline-flex items-center gap-2 text-white! hover:text-secondary! transition-all duration-300 text-sm font-bold opacity-100">
                      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-secondary shrink-0">
                        <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4" />
                        <path d="M9 18c-4.51 2-5-2-7-2" />
                      </svg>
                      <span data-key="codigo" class="lang-text">Código</span>
                    </a>
                  )}
                  {p.demoUrl && (
                    <a href={p.demoUrl} target="_blank" class="inline-flex items-center gap-2 text-white! hover:text-secondary! transition-all duration-300 text-sm font-bold opacity-100">
                      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-secondary shrink-0">
                        <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
                        <polyline points="15 3 21 3 21 9" />
                        <line x1="10" y1="14" x2="21" y2="3" />
                      </svg>
                      <span data-key="verMas" class="lang-text">Ver más</span>
                    </a>
                  )}
                </div>
              </div>
            </div>
          );
        })}
      </div>
    </div>
    
    <div class="flex justify-center">
      <a href="#contacto" class="border border-white/20 bg-white/5 hover:bg-white/10 text-white px-8 py-4 rounded-xl animate-element opacity-0 duration-700 delay-800 inline-flex items-center nav-link backdrop-blur-sm transition-all active:scale-95 font-bold" data-section="contacto">
        <span class="lang-text" data-key="verMasProyectos">Ver Todos los Proyectos</span>
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="ml-2 h-5 w-5 text-secondary">
          <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
          <polyline points="15 3 21 3 21 9" />
          <line x1="10" y1="14" x2="21" y2="3" />
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  /* Animación smooth para el horizontal track */
  .projects-horizontal-track {
    will-change: transform;
  }
</style>
