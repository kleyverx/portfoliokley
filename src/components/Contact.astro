---
---
<section id="contacto" class="w-full py-12 md:py-24 lg:py-32 animate-section opacity-0 transition-all duration-1000 translate-y-10 relative overflow-hidden pointer-events-auto">

  <div class="container mx-auto px-4 md:px-6 relative z-10">
    <div class="flex flex-col items-center justify-center space-y-4 text-center">
      <div class="space-y-2">
        <span class="animate-element opacity-0 transition-all duration-700 inline-flex bg-primary/25 text-secondary text-sm md:text-base hover:bg-primary/35 px-3 py-1 rounded-full border border-primary/40 w-fit font-medium">
          <span class="lang-text" data-key="contactoTitulo">コンタクト • Contacto</span>
        </span>
        <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight animate-element opacity-0 transition-all duration-700 delay-200 neon-text lang-text" data-key="proyectoMente">
          ¿Tienes un proyecto en mente?
        </h2>
        <p class="mx-auto max-w-[700px] text-white/70 md:text-xl/relaxed lg:text-base/relaxed xl:text-xl/relaxed animate-element opacity-0 transition-all duration-700 delay-300 lang-text" data-key="disponible">
          Estoy disponible para trabajar en proyectos freelance y colaboraciones
        </p>
      </div>
    </div>
    <div class="mx-auto grid max-w-5xl items-center gap-6 py-12 lg:grid-cols-2">
      <div class="space-y-4 animate-element opacity-0 transition-all duration-700 delay-400 p-6 rounded-xl glass-panel glass-panel-hover">
        <div class="inline-block rounded-lg bg-primary/20 px-3 py-1 text-sm text-primary lang-text" data-key="infoContacto">
          Información de contacto
        </div>
        <div class="space-y-2">
          <h3 class="text-xl font-bold text-secondary lang-text" data-key="hablemos">Hablemos sobre tu proyecto</h3>
          <p class="text-mutedForeground lang-text" data-key="completaFormulario">
            Completa el formulario o contáctame directamente a través de los siguientes medios:
          </p>
        </div>
        <div class="space-y-4 pt-4">
          <div class="flex items-start gap-4">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="mt-1 h-5 w-5 text-primary clean-icon">
              <path d="M22 17a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V9.5C2 7 4 5 6.5 5H17.5C20 5 22 7 22 9.5V17Z" />
              <path d="m2 9 8.2 5.2c1.1.7 2.5.7 3.6 0L22 9" />
            </svg>
            <div>
              <h4 class="font-medium lang-text" data-key="email">Email</h4>
              <p class="text-sm text-mutedForeground">kleyvercell2@gmail.com</p>
            </div>
          </div>
          <div class="flex items-start gap-4">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="mt-1 h-5 w-5 text-primary clean-icon">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
            </svg>
            <div>
              <h4 class="font-medium lang-text" data-key="telefono">Teléfono</h4>
              <p class="text-sm text-mutedForeground">+58 (424) 110-3017</p>
            </div>
          </div>
          <div class="flex items-start gap-4">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="mt-1 h-5 w-5 text-primary clean-icon">
              <path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0" />
              <circle cx="12" cy="10" r="3" />
            </svg>
            <div>
              <h4 class="font-medium lang-text" data-key="ubicacion">Ubicación</h4>
              <p class="text-sm text-mutedForeground">Caracas, Venezuela</p>
            </div>
          </div>
        </div>
        <div class="flex gap-6 pt-4">
          <a href="https://www.linkedin.com/in/kleyver-cadrazco-655578327/" target="_blank" class="text-mutedForeground hover:text-primary hover:drop-shadow-[0_0_8px_rgba(var(--color-primary),0.8)] transition-all duration-300 hover:scale-110 p-2">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6 clean-icon">
              <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z" />
              <rect width="4" height="12" x="2" y="9" />
              <circle cx="4" cy="4" r="2" />
            </svg>
            <span class="sr-only">LinkedIn</span>
          </a>
          <a href="https://github.com/kleyverx" target="_blank" class="text-mutedForeground hover:text-primary hover:drop-shadow-[0_0_8px_rgba(var(--color-primary),0.8)] transition-all duration-300 hover:scale-110 p-2">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6 clean-icon">
              <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4" />
              <path d="M9 18c-4.51 2-5-2-7-2" />
            </svg>
            <span class="sr-only">GitHub</span>
          </a>
          <a href="https://www.tiktok.com/@kleyver.x?is_from_webapp=1&sender_device=pc" target="_blank" class="text-mutedForeground hover:text-primary hover:drop-shadow-[0_0_8px_rgba(var(--color-primary),0.8)] transition-all duration-300 hover:scale-110 p-2 flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="h-7 w-7 clean-icon">
              <path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5" />
            </svg>
            <span class="sr-only">TikTok</span>
          </a>
          <a href="https://www.instagram.com/kleyver.x?utm_source=ig_web_button_share_sheet&igsh=ZDNlZDc0MzIxNw==" target="_blank" class="text-mutedForeground hover:text-primary hover:drop-shadow-[0_0_8px_rgba(var(--color-primary),0.8)] transition-all duration-300 hover:scale-110 p-2">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6 clean-icon">
              <rect width="20" height="20" x="2" y="2" rx="5" />
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" />
              <line x1="17.5" x2="17.51" y1="6.5" y2="6.5" />
            </svg>
            <span class="sr-only">Instagram</span>
          </a>
        </div>
      </div>
      <div class="space-y-4 animate-element opacity-0 transition-all duration-700 delay-500 p-6 rounded-xl glass-panel glass-panel-hover">
        <form id="contact-form" class="grid gap-4">
          <div class="grid grid-cols-2 gap-4">
            <div class="space-y-2">
              <label for="first-name" class="text-sm font-medium leading-none">
                <span class="lang-text" data-key="nombre">Nombre</span>
              </label>
              <input id="first-name" name="first-name" class="flex h-10 w-full rounded-md border border-primary/20 bg-card/50 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2" placeholder="Nombre" required>
            </div>
            <div class="space-y-2">
              <label for="last-name" class="text-sm font-medium leading-none">
                <span class="lang-text" data-key="apellido">Apellido</span>
              </label>
              <input id="last-name" name="last-name" class="flex h-10 w-full rounded-md border border-primary/20 bg-card/50 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2" placeholder="Apellido" required>
            </div>
          </div>
          <div class="space-y-2">
            <label for="email" class="text-sm font-medium leading-none">
              <span class="lang-text" data-key="email">Email</span>
            </label>
            <input id="email" name="email" type="email" class="flex h-10 w-full rounded-md border border-primary/20 bg-card/50 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2" placeholder="ejemplo@email.com" required>
          </div>
          <div class="space-y-2">
            <label for="subject" class="text-sm font-medium leading-none">
              <span class="lang-text" data-key="asunto">Asunto</span>
            </label>
            <input id="subject" name="subject" class="flex h-10 w-full rounded-md border border-primary/20 bg-card/50 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2" placeholder="Asunto" required>
          </div>
          <div class="space-y-2">
            <label for="message" class="text-sm font-medium leading-none">
              <span class="lang-text" data-key="mensaje">Mensaje</span>
            </label>
            <textarea id="message" name="message" class="flex min-h-[120px] w-full rounded-md border border-primary/20 bg-card/50 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2" placeholder="Escribe tu mensaje aquí..." required></textarea>
          </div>
          <button type="submit" id="submit-btn" class="w-full bg-primary hover:bg-primary/80 text-white px-4 py-2 rounded-md glow-effect mt-4">
            <span class="lang-text" data-key="enviarMensaje">Enviar mensaje</span>
          </button>
        </form>
      </div>
    </div>
  </div>
</section>
