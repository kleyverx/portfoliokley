---
---
<section id="habilidades" class="w-full py-12 md:py-24 lg:py-32 animate-section opacity-0 transition-all duration-1000 translate-y-10 relative overflow-hidden pointer-events-auto">

  <div class="container mx-auto px-4 md:px-6 relative z-10">
    <div class="flex flex-col items-center justify-center space-y-4 text-center">
      <div class="space-y-2">
        <span class="animate-element opacity-0 transition-all duration-700 inline-flex bg-primary/25 text-secondary text-sm md:text-base hover:bg-primary/35 px-3 py-1 rounded-full border border-primary/40 w-fit font-medium">
          <span class="lang-text" data-key="habilidadesTitulo">スキル • Expertise</span>
        </span>
        <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight animate-element opacity-0 transition-all duration-700 delay-200 neon-text lang-text" data-key="misHabilidades">
          Mis Habilidades
        </h2>
        <p class="mx-auto max-w-[700px] text-white/70 md:text-xl/relaxed lg:text-base/relaxed xl:text-xl/relaxed animate-element opacity-0 transition-all duration-700 delay-300 lang-text" data-key="tecnologias">
          Tecnologías y herramientas que domino para crear soluciones digitales
        </p>
      </div>
    </div>
    <div id="skills-grid" class="mx-auto grid max-w-5xl grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 py-12">
      <!-- Categoría: Frontend -->
      <div class="space-y-4 animate-element opacity-0 transition-all duration-700 delay-400 p-6 rounded-xl glass-panel glass-panel-hover">
        <div class="flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6 text-secondary clean-icon drop-shadow-[0_0_8px_rgba(20,200,200,0.4)]">
            <rect width="18" height="18" x="3" y="3" rx="2" />
            <path d="M3 9h18" />
            <path d="M9 21V9" />
          </svg>
          <h3 class="text-xl font-semibold text-secondary lang-text" data-key="frontend">Frontend</h3>
        </div>
        <div class="space-y-2">
          <div class="space-y-1">
            <div class="flex justify-between">
              <span class="text-sm font-medium">HTML</span>
              <span class="text-sm text-mutedForeground">95%</span>
            </div>
            <div class="h-2 w-full rounded-full bg-muted">
              <div class="h-full w-[95%] rounded-full bg-linear-to-r from-primary to-accent"></div>
            </div>
          </div>
          <div class="space-y-1">
            <div class="flex justify-between">
              <span class="text-sm font-medium">CSS</span>
              <span class="text-sm text-mutedForeground">90%</span>
            </div>
            <div class="h-2 w-full rounded-full bg-muted">
              <div class="h-full w-[90%] rounded-full bg-linear-to-r from-primary to-accent"></div>
            </div>
          </div>
          <div class="space-y-1">
            <div class="flex justify-between">
              <span class="text-sm font-medium">JavaScript</span>
              <span class="text-sm text-mutedForeground">70%</span>
            </div>
            <div class="h-2 w-full rounded-full bg-muted">
              <div class="h-full w-[70%] rounded-full bg-linear-to-r from-primary to-accent"></div>
            </div>
          </div>
          <div class="space-y-1">
            <div class="flex justify-between">
              <span class="text-sm font-medium">Tailwind CSS</span>
              <span class="text-sm text-mutedForeground">85%</span>
            </div>
            <div class="h-2 w-full rounded-full bg-muted">
              <div class="h-full w-[85%] rounded-full bg-linear-to-r from-primary to-accent"></div>
            </div>
          </div>
        </div>
      </div>

      <!-- Categoría: Backend -->
      <div class="space-y-4 animate-element opacity-0 transition-all duration-700 delay-500 p-6 rounded-xl glass-panel glass-panel-hover">
        <div class="flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6 text-secondary clean-icon drop-shadow-[0_0_8px_rgba(20,200,200,0.4)]">
            <polyline points="16 18 22 12 16 6" />
            <polyline points="8 6 2 12 8 18" />
            <line x1="14" y1="4" x2="10" y2="20" />
          </svg>
          <h3 class="text-xl font-semibold text-secondary lang-text" data-key="backend">Backend</h3>
        </div>
        <div class="space-y-2">
          <div class="space-y-1">
            <div class="flex justify-between">
              <span class="text-sm font-medium">PHP</span>
              <span class="text-sm text-mutedForeground">75%</span>
            </div>
            <div class="h-2 w-full rounded-full bg-muted">
              <div class="h-full w-[75%] rounded-full bg-linear-to-r from-primary to-accent"></div>
            </div>
          </div>
          <div class="space-y-1">
            <div class="flex justify-between">
              <span class="text-sm font-medium">Node.js</span>
              <span class="text-sm text-mutedForeground">50%</span>
            </div>
            <div class="h-2 w-full rounded-full bg-muted">
              <div class="h-full w-[50%] rounded-full bg-linear-to-r from-primary to-accent"></div>
            </div>
          </div>
          <div class="space-y-1">
            <div class="flex justify-between">
              <span class="text-sm font-medium">Laravel</span>
              <span class="text-sm text-mutedForeground">80%</span>
            </div>
            <div class="h-2 w-full rounded-full bg-muted">
              <div class="h-full w-[80%] rounded-full bg-linear-to-r from-primary to-accent"></div>
            </div>
          </div>
          <div class="space-y-1">
            <div class="flex justify-between">
              <span class="text-sm font-medium">Python</span>
              <span class="text-sm text-mutedForeground">45%</span>
            </div>
            <div class="h-2 w-full rounded-full bg-muted">
              <div class="h-full w-[45%] rounded-full bg-linear-to-r from-primary to-accent"></div>
            </div>
          </div>
        </div>
      </div>

      <!-- Categoría: Bases de Datos -->
      <div class="space-y-4 animate-element opacity-0 transition-all duration-700 delay-600 p-6 rounded-xl glass-panel glass-panel-hover">
        <div class="flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6 text-secondary clean-icon drop-shadow-[0_0_8px_rgba(20,200,200,0.4)]">
            <ellipse cx="12" cy="5" rx="9" ry="3" />
            <path d="M3 5V19C3 20.66 7.03 22 12 22C16.97 22 21 20.66 21 19V5" />
            <path d="M3 12C3 13.66 7.03 15 12 15C16.97 15 21 13.66 21 12" />
          </svg>
          <h3 class="text-xl font-semibold text-secondary lang-text" data-key="basesDatos">Bases de Datos</h3>
        </div>
        <div class="space-y-2">
          <div class="space-y-1">
            <div class="flex justify-between">
              <span class="text-sm font-medium">MySQL</span>
              <span class="text-sm text-mutedForeground">75%</span>
            </div>
            <div class="h-2 w-full rounded-full bg-muted">
              <div class="h-full w-[75%] rounded-full bg-linear-to-r from-primary to-accent"></div>
            </div>
          </div>
          <div class="space-y-1">
            <div class="flex justify-between">
              <span class="text-sm font-medium">MongoDB</span>
              <span class="text-sm text-mutedForeground">50%</span>
            </div>
            <div class="h-2 w-full rounded-full bg-muted">
              <div class="h-full w-[50%] rounded-full bg-linear-to-r from-primary to-accent"></div>
            </div>
          </div>
          <div class="space-y-1">
            <div class="flex justify-between">
              <span class="text-sm font-medium">PostgreSQL</span>
              <span class="text-sm text-mutedForeground">60%</span>
            </div>
            <div class="h-2 w-full rounded-full bg-muted">
              <div class="h-full w-[60%] rounded-full bg-linear-to-r from-primary to-accent"></div>
            </div>
          </div>
        </div>
      </div>

      <!-- Categoría: Frameworks -->
      <div class="space-y-4 animate-element opacity-0 transition-all duration-700 delay-700 p-6 rounded-xl glass-panel glass-panel-hover">
        <div class="flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6 text-secondary clean-icon drop-shadow-[0_0_8px_rgba(20,200,200,0.4)]">
            <path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z" />
            <path d="m3.3 7 8.7 5 8.7-5" />
            <path d="M12 22V12" />
          </svg>
          <h3 class="text-xl font-semibold text-secondary lang-text" data-key="frameworks">Frameworks</h3>
        </div>
        <div class="space-y-2">
          <div class="space-y-1">
            <div class="flex justify-between">
              <span class="text-sm font-medium">Angular</span>
              <span class="text-sm text-mutedForeground">50%</span>
            </div>
            <div class="h-2 w-full rounded-full bg-muted">
              <div class="h-full w-[50%] rounded-full bg-linear-to-r from-primary to-accent"></div>
            </div>
          </div>
          <div class="space-y-1">
            <div class="flex justify-between">
              <span class="text-sm font-medium">Laravel</span>
              <span class="text-sm text-mutedForeground">80%</span>
            </div>
            <div class="h-2 w-full rounded-full bg-muted">
              <div class="h-full w-[80%] rounded-full bg-linear-to-r from-primary to-accent"></div>
            </div>
          </div>
          <div class="space-y-1">
            <div class="flex justify-between">
              <span class="text-sm font-medium">React</span>
              <span class="text-sm text-mutedForeground">65%</span>
            </div>
            <div class="h-2 w-full rounded-full bg-muted">
              <div class="h-full w-[65%] rounded-full bg-linear-to-r from-primary to-accent"></div>
            </div>
          </div>
        </div>
      </div>

      <!-- Categoría: Lenguajes -->
      <div class="space-y-4 animate-element opacity-0 transition-all duration-700 delay-800 p-6 rounded-xl glass-panel glass-panel-hover">
        <div class="flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6 text-secondary clean-icon drop-shadow-[0_0_8px_rgba(20,200,200,0.4)]">
            <polyline points="16 18 22 12 16 6" />
            <polyline points="8 6 2 12 8 18" />
          </svg>
          <h3 class="text-xl font-semibold text-secondary lang-text" data-key="lenguajes">Lenguajes</h3>
        </div>
        <div class="space-y-2">
          <div class="space-y-1">
            <div class="flex justify-between">
              <span class="text-sm font-medium">JavaScript</span>
              <span class="text-sm text-mutedForeground">70%</span>
            </div>
            <div class="h-2 w-full rounded-full bg-muted">
              <div class="h-full w-[70%] rounded-full bg-linear-to-r from-primary to-accent"></div>
            </div>
          </div>
          <div class="space-y-1">
            <div class="flex justify-between">
              <span class="text-sm font-medium">TypeScript</span>
              <span class="text-sm text-mutedForeground">50%</span>
            </div>
            <div class="h-2 w-full rounded-full bg-muted">
              <div class="h-full w-[50%] rounded-full bg-linear-to-r from-primary to-accent"></div>
            </div>
          </div>
          <div class="space-y-1">
            <div class="flex justify-between">
              <span class="text-sm font-medium">PHP</span>
              <span class="text-sm text-mutedForeground">75%</span>
            </div>
            <div class="h-2 w-full rounded-full bg-muted">
              <div class="h-full w-[75%] rounded-full bg-linear-to-r from-primary to-accent"></div>
            </div>
          </div>
          <div class="space-y-1">
            <div class="flex justify-between">
              <span class="text-sm font-medium">Python</span>
              <span class="text-sm text-mutedForeground">45%</span>
            </div>
            <div class="h-2 w-full rounded-full bg-muted">
              <div class="h-full w-[45%] rounded-full bg-linear-to-r from-primary to-accent"></div>
            </div>
          </div>
        </div>
      </div>

      <!-- Categoría: Herramientas -->
      <div class="space-y-4 animate-element opacity-0 transition-all duration-700 delay-900 p-6 rounded-xl glass-panel glass-panel-hover">
        <div class="flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6 text-secondary clean-icon drop-shadow-[0_0_8px_rgba(20,200,200,0.4)]">
            <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z" />
          </svg>
          <h3 class="text-xl font-semibold text-secondary lang-text" data-key="herramientas">Herramientas</h3>
        </div>
        <div class="space-y-2">
          <div class="space-y-1">
            <div class="flex justify-between">
              <span class="text-sm font-medium">Git</span>
              <span class="text-sm text-mutedForeground">70%</span>
            </div>
            <div class="h-2 w-full rounded-full bg-muted">
              <div class="h-full w-[70%] rounded-full bg-linear-to-r from-primary to-accent"></div>
            </div>
          </div>
          <div class="space-y-1">
            <div class="flex justify-between">
              <span class="text-sm font-medium">Figma</span>
              <span class="text-sm text-mutedForeground">60%</span>
            </div>
            <div class="h-2 w-full rounded-full bg-muted">
              <div class="h-full w-[60%] rounded-full bg-linear-to-r from-primary to-accent"></div>
            </div>
          </div>
          <div class="space-y-1">
            <div class="flex justify-between">
              <span class="text-sm font-medium">VS Code</span>
              <span class="text-sm text-mutedForeground">85%</span>
            </div>
            <div class="h-2 w-full rounded-full bg-muted">
              <div class="h-full w-[85%] rounded-full bg-linear-to-r from-primary to-accent"></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
