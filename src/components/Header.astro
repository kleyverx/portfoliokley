---
---
<header class="sticky top-0 z-40 w-full border-b border-border/50 bg-background/80 backdrop-blur">
  <div class="container mx-auto px-4 flex h-16 items-center justify-between">
    <a href="#" class="font-bold text-3xl text-primary neon-text">
      クレイバー<span class="text-xl ml-1">Portfolio</span>
    </a>
    <nav id="desktop-nav" class="hidden md:flex md:flex-row md:gap-6">
      <button data-section="inicio" class="text-sm font-medium hover:text-primary transition-colors py-2 md:py-0 text-left nav-link">
        <span class="lang-text" data-key="inicio">Inicio</span>
      </button>
      <button data-section="proyectos" class="text-sm font-medium hover:text-primary transition-colors py-2 md:py-0 text-left nav-link">
        <span class="lang-text" data-key="proyectos">Proyectos</span>
      </button>
      <button data-section="videos" class="text-sm font-medium hover:text-primary transition-colors py-2 md:py-0 text-left nav-link">
        <span class="lang-text" data-key="videos">Videos</span>
      </button>
      <button data-section="habilidades" class="text-sm font-medium hover:text-primary transition-colors py-2 md:py-0 text-left nav-link">
        <span class="lang-text" data-key="habilidades">Habilidades</span>
      </button>
      <button data-section="servicios" class="text-sm font-medium hover:text-primary transition-colors py-2 md:py-0 text-left nav-link">
        <span class="lang-text" data-key="servicios">Servicios</span>
      </button>
      <button data-section="contacto" class="text-sm font-medium hover:text-primary transition-colors py-2 md:py-0 text-left nav-link">
        <span class="lang-text" data-key="contacto">Contacto</span>
      </button>
    </nav>
    <button id="download-cv" class="hidden md:flex bg-primary hover:bg-primary/80 text-white px-4 py-2 rounded-md text-sm">
      Descargar CV
    </button>
    <button id="mobile-menu-button" class="md:hidden border border-primary/50 bg-primary/5 p-2 rounded-md">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5 clean-icon">
        <line x1="4" x2="20" y1="12" y2="12" />
        <line x1="4" x2="20" y1="6" y2="6" />
        <line x1="4" x2="20" y1="18" y2="18" />
      </svg>
    </button>
  </div>
  <nav id="mobile-nav" class="hidden flex-col absolute top-16 left-0 w-full bg-background/95 p-4 border-b border-border/50 z-50">
    <button data-section="inicio" class="text-sm font-medium hover:text-primary transition-colors py-2 text-left nav-link">
      <span class="lang-text" data-key="inicio">Inicio</span>
    </button>
    <button data-section="proyectos" class="text-sm font-medium hover:text-primary transition-colors py-2 text-left nav-link">
      <span class="lang-text" data-key="proyectos">Proyectos</span>
    </button>
    <button data-section="videos" class="text-sm font-medium hover:text-primary transition-colors py-2 text-left nav-link">
      <span class="lang-text" data-key="videos">Videos</span>
    </button>
    <button data-section="habilidades" class="text-sm font-medium hover:text-primary transition-colors py-2 text-left nav-link">
      <span class="lang-text" data-key="habilidades">Habilidades</span>
    </button>
    <button data-section="servicios" class="text-sm font-medium hover:text-primary transition-colors py-2 text-left nav-link">
      <span class="lang-text" data-key="servicios">Servicios</span>
    </button>
    <button data-section="contacto" class="text-sm font-medium hover:text-primary transition-colors py-2 text-left nav-link">
      <span class="lang-text" data-key="contacto">Contacto</span>
    </button>
  </nav>
</header>
