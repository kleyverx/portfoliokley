---
---
<section id="videos" class="w-full pt-8 pb-16 md:pt-12 md:pb-24 lg:pt-16 lg:pb-32 relative overflow-hidden bg-transparent">
  <div class="container px-4 md:px-6 relative z-10 mx-auto">
    <div class="flex flex-col items-center justify-center space-y-4 text-center mb-16">
      <div class="space-y-4">
        <span class="animate-element opacity-0 transition-all duration-700 inline-flex bg-primary/25 text-secondary text-sm md:text-base hover:bg-primary/35 px-3 py-1 rounded-full border border-primary/40 w-fit font-medium">
          <span class="lang-text" data-key="misVideos">ビデオ • Videos</span>
        </span>
        <h2 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold animate-element opacity-0 translate-y-4 transition-all duration-700 neon-text">
           Video <span class="text-secondary">Showcase</span>
        </h2>
        <p class="mx-auto max-w-[700px] text-white/70 md:text-xl animate-element opacity-0 translate-y-4 transition-all duration-700 delay-200 lang-text" data-key="videosDesc">
          Explora mis tutoriales, demostraciones de proyectos y contenido creativo.
        </p>
      </div>
    </div>
    
    <div 
      id="videos-grid" 
      class="videos-container mx-auto flex flex-wrap justify-center gap-4 w-full max-w-4xl"
    >
      <!-- Los videos se cargan dinámicamente desde videos.js -->
    </div>

    <div class="mt-16 flex justify-center animate-element opacity-0 translate-y-4 transition-all duration-700 delay-500">
      <a 
        href="https://www.youtube.com/@kleyverurbina" 
        target="_blank" 
        rel="noopener noreferrer" 
        class="border border-white/20 bg-white/5 hover:bg-white/10 text-white px-8 py-4 rounded-xl inline-flex items-center backdrop-blur-sm transition-all active:scale-95 font-bold group"
      >
        <span class="text-lg lang-text" data-key="verMasVideos">Ver más en YouTube</span>
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 text-secondary group-hover:translate-x-1 transition-transform ml-3">
          <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
          <polyline points="15 3 21 3 21 9"></polyline>
          <line x1="10" y1="14" x2="21" y2="3"></line>
        </svg>
      </a>
    </div>
  </div>
</section>


